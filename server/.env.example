DATABASE_URL="postgresql://user:password@localhost:5432/raising"
JWT_SECRET="long-random-string-min-32-chars-change-me-please"
JWT_EXPIRES_IN="7d"
RESEND_API_KEY=""
# Required with RESEND_API_KEY in production; must be verified by the provider.
EMAIL_FROM="raising <notifications@example.com>"
CLIENT_URL="http://localhost:5174"
# Required when Vercel cron is enabled; Vercel sends it as a Bearer token.
CRON_SECRET=""
PORT=3000
NODE_ENV=development

# Optional — seeds the first superadmin account when set (run: pnpm --filter raising-server seed)
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Super Admin"
